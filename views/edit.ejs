<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit your Post</title>
</head>
<body>
    <h2>Here you can edit your post</h2>
    <h3>post id : <%= post.id %> </h3>
    <h3>Post username:@<%= post.username %> </h3>
    <form method="post" action="/posts/<%= post.id %>?_method=PATCH">
        <textarea name="content" id="" rows="10" cols="35"><%= post.content %></textarea>
        <br>
        <button>submit</button>
    </form>
</body>
</html>